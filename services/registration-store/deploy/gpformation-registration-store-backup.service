[Unit]
Description=Back up the GP Formation registration SQLite database
After=gpformation-registration-store.service

[Service]
Type=oneshot
User=gpformation-store
Group=gpformation-store
WorkingDirectory=/opt/gpformation-registration-store
EnvironmentFile=/etc/gpformation-registration-store.env
ExecStart=/usr/bin/python3 /opt/gpformation-registration-store/backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gpformation-registration-store
